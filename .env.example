# Copy this file to .env and fill in your keys. Never commit .env.

# Claude, for the agents, routed through Portkey
# ANTHROPIC_API_KEY is unused under Portkey
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5

# Portkey gateway
PORTKEY_API_KEY=
PORTKEY_VIRTUAL_KEY=

# LangSmith, for tracing
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=fde-prototype-dryrun

# SEC EDGAR, for downloading filings. The SEC requires a name and contact email.
SEC_USER_AGENT=
